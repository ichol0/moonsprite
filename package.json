{
  "name": "moonsprite",
  "version": "0.1.0-dev.3",
  "description": "An original, open-source pixel art workstation for Windows.",
  "author": "MoonSprite contributors",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.ts",
    "build": "tauri build",
    "build:thumbnail": "cargo build --manifest-path src-tauri/thumbnail-provider/Cargo.toml --release",
    "build:web": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tauri": "node scripts/tauri-smoke.mjs",
    "test:desktop": "node scripts/desktop-regression.mjs",
    "check:dev": "node scripts/run-validation.mjs dev",
    "check:release": "node scripts/run-validation.mjs release",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:version": "node scripts/check-version-contract.mjs",
    "check:performance": "pnpm bench:selection && pnpm bench:canvas -- --full",
    "check:fast": "node scripts/run-validation.mjs fast",
    "check:integration": "node scripts/run-validation.mjs integration",
    "bench:canvas": "pnpm build:web && node scripts/canvas-performance.mjs",
    "bench:canvas:full": "pnpm bench:canvas -- --full",
    "bench:selection": "vitest bench src/renderer/src/core/selection-performance.bench.ts --run",
    "check:performance-scope": "node scripts/performance-scope.mjs",
    "check:maintenance": "node --test scripts/canvas-performance-options.test.mjs scripts/changelog-policy.test.mjs scripts/performance-scope-rules.test.mjs scripts/validation-scope.test.mjs scripts/version-contract.test.mjs && node scripts/check-maintenance-contract.mjs && node scripts/check-version-contract.mjs && node scripts/check-changelog-update.mjs",
    "package": "tauri build && pnpm package:prepare && pnpm package:size",
    "package:prepare": "node scripts/prepare-release.mjs",
    "package:size": "node scripts/check-package-size.mjs",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/upng-js": "2.1.5",
    "@vitejs/plugin-react": "6.0.4",
    "fflate": "0.8.3",
    "jsdom": "29.1.1",
    "lucide-react": "1.26.0",
    "playwright": "1.62.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "upng-js": "2.1.0",
    "zustand": "5.0.14"
  },
  "packageManager": "pnpm@11.9.0"
}
